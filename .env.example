# Set to true only when building for a GitHub Pages project repository.
GITHUB_PAGES=false
# Set true only for a GitHub Pages custom-domain build; this disables repository basePath.
CUSTOM_DOMAIN=false
# Optional explicit build-time base path, such as /REPOSITORY. Empty locally.
BASE_PATH=
# Canonical origin used in metadata, sitemap, and RSS.
NEXT_PUBLIC_SITE_URL=https://example.com
